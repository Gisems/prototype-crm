{
  "name": "@g2i/crm-backend",
  "version": "0.0.1",
  "private": true,
  "description": "API del CRM ChatG2I",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "knip": "knip",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --pretty --noEmit",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck",
    "fix": "pnpm lint:fix && pnpm fmt"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "qs": "^6.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/qs": "^6.15.1",
    "@vitest/coverage-v8": "^5.0.1",
    "knip": "^6.37.0",
    "oxfmt": "^0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "^6.0.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.9.0"
  }
}
