{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "sortImports": {
    "internalPattern": ["app/", "config", "core/", "layouts/", "router", "shared/"]
  },
  "sortTailwindcss": {
    "stylesheet": "./src/shared/styles/globals.css",
    "functions": ["cn", "cva"]
  },
  "sortPackageJson": true,
  "ignorePatterns": ["dist/", "build/", ".react-router/", "public/prototype/", "pnpm-lock.yaml"]
}
