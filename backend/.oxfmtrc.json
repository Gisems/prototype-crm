{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "sortImports": {
    "internalPattern": ["@common/", "@modules/"]
  },
  "sortPackageJson": true,
  "ignorePatterns": ["dist/", "coverage/", "certs/", "pnpm-lock.yaml"]
}
