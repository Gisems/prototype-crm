{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "eqeqeq": "error",
    "no-console": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-template": "error",
    "object-shorthand": "error",
    "no-else-return": "error",
    "no-useless-rename": "error",
    "no-useless-computed-key": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-case-declarations": "error",
    "no-param-reassign": "error",
    "no-nested-ternary": "error",
    "require-await": "error",
    "no-return-assign": "error",
    "no-throw-literal": "error",
    "default-case-last": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../../*"],
            "message": "Usa los alias de tsconfig (@common, @modules) en vez de rutas relativas profundas."
          }
        ]
      }
    ],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-namespace": "error",
    "typescript/prefer-as-const": "error",
    "typescript/array-type": ["error", { "default": "array" }],
    "typescript/consistent-type-definitions": ["error", "interface"],
    "typescript/no-inferrable-types": "error",
    "typescript/no-empty-interface": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-useless-constructor": "error",
    "typescript/no-extraneous-class": ["error", { "allowWithDecorator": true }],
    "typescript/consistent-type-imports": "off",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-deprecated": "warn",
    "typescript/no-unsafe-type-assertion": "off",

    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/prefer-type-error": "error",
    "unicorn/no-useless-spread": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/prefer-string-starts-ends-with": "error",

    "import/no-commonjs": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/first": "error",

    "promise/param-names": "error",
    "promise/no-return-wrap": "error",
    "promise/prefer-await-to-then": "error"
  },
  "overrides": [
    {
      "files": ["src/common/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@modules/*", "@modules/**"],
                "message": "src/common no depende de src/modules: mueve el código al módulo que lo usa."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/entities/*.entity.ts"],
      "rules": {
        "import/no-cycle": "off"
      }
    },
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts", "test/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off"
      }
    }
  ],
  "ignorePatterns": ["dist/", "coverage/"]
}
