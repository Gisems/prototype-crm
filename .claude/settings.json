			"Bash(pnpm build *)",
			"Bash(pnpm test *)",
			"Bash(pnpm exec *)",
			"Bash(npx tsc *)",
			"Bash(npx oxlint *)",
			"Bash(npx oxfmt *)",
			"Bash(npx tsx *)",
			"Bash(node *)",
			"Bash(python3 *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git show *)",
			"Bash(git checkout *)",
			"Bash(git pull *)",
			"Bash(git grep *)",
			"Bash(git add *)"
