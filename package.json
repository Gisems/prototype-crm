{
  "name": "g2i-crm",
  "version": "0.0.1",
  "private": true,
  "description": "ChatG2I CRM multicanal: monolito con backend NestJS y frontend React Router",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:back": "pnpm --filter @g2i/crm-backend start:dev",
    "dev:front": "pnpm --filter @g2i/crm-frontend dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "fmt": "pnpm -r fmt",
    "fmt:check": "pnpm -r fmt:check",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm -r check",
    "fix": "pnpm -r fix",
    "knip": "pnpm -r knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "volta": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
